akr 0.1
project pixelkit

record pixelkit.work.raster-simd-coverage/1 : work {
    title "Measured exact SIMD coverage in raster kernels"
    state proposed
    intent """
        Keep coverage merging bit exact while adding SIMD only where profiles
        justify it. The initial u8x32 path handles rows of at least 1024 bytes;
        shorter glyph spans retain the scalar loop. Compare scalar and vector
        medians for short and long rows on aarch64 and x86_64, then expand to
        alpha coverage blending or opaque bitmap rows only after equivalent
        output and a measured speed benefit. Preserve clipped tails and portable
        behavior on unsupported targets.
        """
}

record pixelkit.work.windowing-crate/1 : work {
    title "Windowing crate: host move, multi-window, panes, in-app windows"
    state completed
    intent """
        Move OS-window hosting out of pixelkit-shell into a new pixelkit-windowing
        crate, add a multi-OS-window runner, and add in-app draggable panes plus
        in-app floating windows behind small caller-owned state types, with unit
        tests for the layout and drag state machines.
        """
    note """
        User decisions (2026-09-29): both OS-level and in-app windows; new crate
        named pixelkit-windowing. Event vocabulary used by shell's Input collector
        (KeyInput, Modifiers, MouseButton) stays in pixelkit-shell; host/app
        protocol types move with the host.
        """
}
